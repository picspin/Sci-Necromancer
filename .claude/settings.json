{
  "model": "mga-gpt-5",
  "apiProvider": "litellm",
  "litellmConfig": {
    "configPath": "~/.config/cc_all_in/litellm_config.yaml",
    "apiBase": "http://localhost:4000/v1"
  },
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "@anthropic-ai/mcp-server-chrome-devtools"]
    }
  },
  "permissions": {
    "allow": ["Npm run lint:file:*"]
  }
}
