{
  "version": "1.0.0",
  "hooks": {
    "pre-commit": {
      "enabled": true,
      "autoFix": true,
      "maxAttempts": 3,
      "checks": {
        "typescript": true,
        "eslint": true,
        "prettier": true
      }
    }
  },
  "validation": {
    "strict": true,
    "allowWarnings": false,
    "maxFileSize": 5242880,
    "checkTodos": true,
    "checkConsoleLogs": true
  },
  "claudeCode": {
    "enabled": true,
    "cli": "cc",
    "timeout": 60000
  }
}
