{
  "skill_seeker": {
    "enabled": true,
    "auto_scan": true,
    "scan_interval": 3600,
    "skills": {
      "project_structure": {
        "enabled": true,
        "description": "自动分析项目结构和架构"
      },
      "dependencies": {
        "enabled": true,
        "description": "分析项目依赖和版本"
      },
      "code_patterns": {
        "enabled": true,
        "description": "识别代码模式和最佳实践"
      },
      "testing": {
        "enabled": true,
        "description": "分析测试覆盖率和测试模式"
      },
      "documentation": {
        "enabled": true,
        "description": "提取和分析文档"
      },
      "performance": {
        "enabled": true,
        "description": "识别性能瓶颈"
      },
      "security": {
        "enabled": true,
        "description": "检查安全问题"
      }
    },
    "scan_paths": ["src", "lib", "tests", "docs"],
    "ignore_patterns": ["node_modules", ".git", "dist", "build", ".env*"]
  }
}
