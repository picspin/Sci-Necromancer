# Public browser configuration (safe to expose)
VITE_API_BASE_URL=https://your-us-vercel-backend.example.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
VITE_TURNSTILE_SITE_KEY=your-public-turnstile-site-key

# Server-only Vercel variables (never prefix these with VITE_)
APP_ORIGINS=https://www.rad-sci.org,http://localhost:3000
APP_PUBLIC_URL=https://www.rad-sci.org
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-on-vercel
TURNSTILE_SECRET_KEY=replace-on-vercel
GEMINI_API_KEY=replace-on-vercel
OPENAI_API_KEY=replace-on-vercel
# Optional managed MGA provider. Configure both or neither.
MGA_BASE_URL=https://your-mga-host.example.com/api/v2
MGA_API_KEY=replace-on-vercel
MGA_TEXT_MODEL=glm-5.2
MGA_RESEARCH_AGENT_MODEL=glm-5
MGA_IMAGE_AGENT_MODEL=glm-5.2
MGA_IMAGEN_MODEL=imagen-4
MGA_GPT_IMAGE_MODEL=gpt-image-1
MGA_HELP_MODEL=gpt-oss-120b
MGA_IMAGE_HOST=mygenassist-prod-generated-documents.s3.eu-central-1.amazonaws.com
STRIPE_SECRET_KEY=replace-on-vercel
STRIPE_WEBHOOK_SECRET=replace-on-vercel
HEALTHCHECK_TOKEN=replace-on-vercel
